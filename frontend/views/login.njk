{% extends "layout.njk" %}
{% block content %}
<section class="login-screen d-flex align-items-center justify-content-center">
  <div class="login-card card shadow-lg border-0">
    <div class="card-body p-4 p-md-5">
      <p class="page-kicker text-success fw-semibold mb-2">ERP Agrícola</p>
      <h1 class="h3 fw-bold mb-2">Acesso ao sistema</h1>
      <p class="text-secondary mb-4">Controle de pastejo rotacionado.</p>

      <form id="loginForm" data-servidor-dw3="{{ servidorDw3 }}">
        <div id="loginError" class="alert alert-danger d-none" role="alert"></div>

        <div class="mb-3">
          <label class="form-label" for="usuario">Usuário</label>
          <input class="form-control" id="usuario" name="usuario" type="text"
            placeholder="Seu usuário" autocomplete="username" required>
        </div>

        <div class="mb-4">
          <label class="form-label" for="senha">Senha</label>
          <input class="form-control" id="senha" name="senha" type="password"
            placeholder="Sua senha" autocomplete="current-password" required>
        </div>

        <button class="btn btn-success w-100" type="submit">Entrar</button>
      </form>
    </div>
  </div>
</section>

<script src="/js/dw3frontend.js"></script>
<script src="/apps/login/vwLogin.js"></script>
{% endblock %}