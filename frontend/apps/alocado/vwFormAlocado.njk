{% extends "layout.njk" %}
{% block content %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css">

<header class="page-header">
  <p class="page-kicker text-success fw-semibold mb-2">Movimentação</p>
  <h1 class="h3 fw-bold mb-2">Formulário de alocações</h1>
  <p class="text-secondary mb-0">Vincule um animal a um piquete e defina o período de pastejo.</p>
</header>

<div class="card page-card border-0 shadow-sm">
  <div class="card-body p-4">
    <div class="mb-4">
      <h2 class="h5 fw-semibold mb-1">Dados da alocação</h2>
      <p class="text-secondary mb-0">Informe os campos abaixo para concluir a operação.</p>
    </div>

    <form id="frmAlocado" data-servidor-dw3="{{ servidorDw3 }}">
      <input type="hidden" id="alocadoid" name="alocadoid" value="0">
      <input type="hidden" id="removido" name="removido" value="false">

      <div class="row g-3">
        <div class="col-12 col-md-6">
          <label for="animalidfk" class="form-label">Animal</label>
          <select class="form-select" id="animalidfk" name="animalidfk" required>
            <option value="">Selecione um animal</option>
          </select>
        </div>

        <div class="col-12 col-md-6">
          <label for="piqueteidfk" class="form-label">Piquete</label>
          <select class="form-select" id="piqueteidfk" name="piqueteidfk" required>
            <option value="">Selecione um piquete</option>
          </select>
        </div>

        <div class="col-12 col-md-6">
          <label for="datainicio" class="form-label">Data de Início</label>
          <input type="date" class="form-control" id="datainicio" name="datainicio" required>
        </div>

        <div class="col-12 col-md-6">
          <label for="datafinal" class="form-label">Data Final (opcional)</label>
          <input type="date" class="form-control" id="datafinal" name="datafinal">
        </div>
      </div>

      <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
        <button type="button" class="btn btn-success d-none" id="btnInserirAlocado">
          <i class="bi bi-plus-lg me-1"></i>Inserir
        </button>
        <button type="button" class="btn btn-warning d-none" id="btnAtualizarAlocado">
          <i class="bi bi-pencil-square me-1"></i>Atualizar
        </button>
        <button type="button" class="btn btn-danger d-none" id="btnRemoverAlocado">
          <i class="bi bi-trash me-1"></i>Remover
        </button>
        <a class="btn btn-outline-secondary" href="/alocado" id="btnFecharAlocado">
          <i class="bi bi-x-lg me-1"></i>Fechar
        </a>
      </div>
    </form>
  </div>
</div>

<script src="/js/dw3frontend.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="/apps/alocado/vwFormAlocado.js"></script>
{% endblock %}