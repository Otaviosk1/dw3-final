{% extends "layout.njk" %}
{% block content %}
<link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.css">

<header class="page-header">
  <p class="page-kicker text-success fw-semibold mb-2">Movimentação</p>
  <h1 class="h3 fw-bold mb-2">Alocações</h1>
  <p class="text-secondary mb-0">Controle a alocação dos animais nos piquetes ao longo do tempo.</p>
</header>

<div class="card page-card border-0 shadow-sm">
  <div class="card-body p-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
      <div>
        <h2 class="h5 fw-semibold mb-1">Lista de alocações</h2>
        <p class="text-secondary mb-0">Registros ativos retornados pelo servidor back-end.</p>
      </div>
      <a class="btn btn-success" href="/alocado/form?oper=Cr" id="btnNovoAlocado">
        <i class="bi bi-plus-lg me-1"></i>Incluir nova alocação
      </a>
    </div>

    <div id="alocadoAlert" class="alert alert-danger d-none" role="alert"></div>

    <div id="alocadoListagem" data-servidor-dw3="{{ servidorDw3 }}">
      <div class="table-responsive">
        <table id="tblAlocado" class="table table-striped table-hover align-middle w-100">
          <thead>
            <tr>
              <th>ID</th>
              <th>Animal</th>
              <th>Piquete</th>
              <th>Data Início</th>
              <th>Data Final</th>
              <th>Operações</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="/js/dw3frontend.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
<script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.js"></script>
<script src="/apps/alocado/vwLstAlocado.js"></script>
{% endblock %}